BASE_URL=https://rub21.apis.dev.openstreetmap.org
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
SCOPES=read_prefs write_gpx read_gpx

# Either an explicit list...
TEST_USERS=mapper01,mapper02
# ...or generate mapper1..mapperN (used only when TEST_USERS is empty)
TEST_USER_PREFIX=mapper
TEST_USER_COUNT=10
TEST_USER_PASSWORD=12345678

# Visibilities used on upload, picked at random per trace.
# Allowed: private, public, trackable, identifiable
VISIBILITIES=trackable,identifiable

GPX_DIR=./data/gpx
GPX_ONLY_FOLDERS=identifiable
TOKENS_FILE=./tokens.json
STATE_FILE=./state.jsonl
GPX_ONLY_FOLDERS=identifiable
