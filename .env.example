BASE_URL=https://gpx-tracks.rub21.com

# Where osm-dev runs, for `make tokens`: root@ip, or local for ../osm-dev
SERVER=

GPX_DIR=./data/gpx
GPX_ONLY_FOLDERS=identifiable

# Visibility of each upload, picked at random from this list.
# Allowed: private, public, trackable, identifiable
VISIBILITIES=trackable,identifiable

TOKENS_FILE=./tokens.json
STATE_FILE=./state.jsonl

# Only for instances that are not osm-dev (scripts/get_tokens.py).
# Register an OAuth 2 app on the instance and fill these.
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
SCOPES=read_prefs write_gpx read_gpx
TEST_USERS=admin,Rub21,mapper1,mapper2,mapper3
TEST_USER_PASSWORD=12345678
